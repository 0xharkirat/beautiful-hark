---
/**
 * Google Analytics 4.
 *
 * Renders nothing unless PUBLIC_GA_ID is set, so local dev and any
 * environment without the variable stay clean. Set it for Production only in
 * Vercel and preview deployments will not pollute the property.
 */
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

{
  GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());

        /*
          send_page_view: false, then one manual page_view per astro:page-load.

          ClientRouter navigations are not document loads, so gtag's automatic
          page_view fires once and every subsequent page goes uncounted.
          astro:page-load fires on the initial load *and* after each swap, so
          sending it ourselves covers both with no double count.
        */
        gtag('config', GA_ID, { send_page_view: false });

        // The head persists across swaps, so this script should run once. Guard
        // anyway: a second registration would double every page_view, and
        // silently inflated analytics is worse than none.
        if (!window.__gaPageViewBound) {
          window.__gaPageViewBound = true;
          document.addEventListener('astro:page-load', () => {
            gtag('event', 'page_view', {
              page_title: document.title,
              page_location: location.href,
              page_path: location.pathname + location.search,
            });
          });
        }
      </script>
    </>
  )
}
