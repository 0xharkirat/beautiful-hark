---
/**
 * Umami, replacing Google Analytics.
 *
 * GA was wired here and dormant: 49 lines behind PUBLIC_GA_ID that were never
 * switched on in production. Leaving it was the risk, not running it. Setting
 * that one variable would have shipped roughly 50KB of gtag plus cookies that
 * legally need a consent banner, onto a site whose whole browser payload is one
 * 16KB bundle.
 *
 * Umami is about 2KB, sets no cookies, and needs no banner. It answers the
 * questions actually being asked: how many people, which countries, how much of
 * it is bots.
 *
 * Renders nothing unless PUBLIC_UMAMI_WEBSITE_ID is set, so local dev and any
 * environment without the variable stay clean. Set it for Production only in
 * Vercel, or preview deployments will pollute the numbers with your own builds.
 */
const UMAMI_ID = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

{
  UMAMI_ID && (
    <>
      {/*
        data-auto-track="false", then one manual track per astro:page-load.

        Umami's own auto-tracking hooks pushState, and ClientRouter does use
        pushState, so this would half-work by accident. It would also be
        counting a navigation that Astro has not finished swapping, so the URL
        and the title could disagree about which page was viewed.

        astro:page-load fires on the first load and after every swap, which is
        exactly the set of moments that count as a page view here. The GA
        version this replaces had learned the same thing.
      */}
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={UMAMI_ID}
        data-auto-track="false"
      />
      <script is:inline>
        {/*
          The head persists across swaps, so this should register once. Guard
          anyway: a second listener doubles every page view, and quietly
          inflated numbers are worse than no numbers.
        */}
        if (!window.__umamiBound) {
          window.__umamiBound = true;
          document.addEventListener('astro:page-load', () => {
            // Optional chaining because the script is deferred: the first
            // page-load can beat it, and a missing umami must not throw.
            window.umami?.track();
          });
        }
      </script>
    </>
  )
}
