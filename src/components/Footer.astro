---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsGlobal } from '../lib/data';
import { isExternal } from '../lib/links';
import ExternalMark from './richtext/ExternalMark.astro';

interface Props {
  config?: CmsGlobal | null;
}

const LABELS: Record<string, string> = {
  FaGithub: 'github',
  FaXTwitter: 'x',
  FaLinkedin: 'linkedin',
  FaYoutube: 'youtube',
  FaFacebookF: 'facebook',
  AiFillInstagram: 'instagram',
  'ssw-icon': 'ssw',
};

function label(raw?: string | null) {
  if (!raw) return '';
  if (LABELS[raw]) return LABELS[raw];
  return raw.replace(/^(Fa6?|Ai(Fill|Outline)?|Bi)/i, '').toLowerCase() || raw;
}

const { config } = Astro.props;
const footer = config?.footer ?? null;
const social = (footer?.social ?? []).filter((s) => s !== null);
const tagline = footer?.tagline ?? null;
const colophon = footer?.colophon ?? null;

// These three URLs come from Tina, so "external" is a fact about the data, not
// something to hardcode. They were all unconditionally target="_blank", which
// is wrong the moment someone points the tagline at a page on this site: a new
// tab for an internal link is never what a reader wants.
const ext = (u?: string | null) => isExternal(u, Astro.site);
---

<footer class="column pt-10 pb-16 mt-20">
  <hr class="rule" />

  <!-- gap-y clears the .tap negative margins so wrapped rows can't overlap -->
  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-6">
    <a href="/feed.xml" class="quiet tap">rss</a>
    <!-- Hardcoded next to rss rather than added to the Tina nav: the bird is
         an easter egg, and a fifth nav item would announce it. -->
    <a href="/hawky" class="quiet tap">hawky</a>
    <!-- Also hardcoded rather than added to the Tina nav. /tea is a standing
         invitation, not a section of the site, and a seventh nav item would
         give it more weight in the header than it wants. -->
    <a href="/tea" class="quiet tap">tea</a>
    {social.map((s) => (
      <a
        href={s.url ?? '#'}
        target={ext(s.url) ? '_blank' : undefined}
        rel={ext(s.url) ? 'noopener noreferrer' : undefined}
        data-tina-field={tinaField(s, 'url')}
        class="quiet tap"
      >
        {label(s.icon?.name)}{ext(s.url) && <ExternalMark />}
      </a>
    ))}
  </div>

  <!-- Tagline left, colophon right. flex-wrap means a narrow viewport puts
       each on its own line, and a lone item on a wrapped line sits at the
       start, so the colophon left-aligns instead of hanging off the right
       edge against nothing. -->
  {(tagline?.label || colophon?.label) && (
    <div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
      {tagline?.label && (
        <p class="serif italic tagline">
          <a
            href={tagline.url ?? '#'}
            target={ext(tagline.url) ? '_blank' : undefined}
            rel={ext(tagline.url) ? 'noopener noreferrer' : undefined}
            data-tina-field={tinaField(tagline, 'label')}
            class="link"
          >{tagline.label}{ext(tagline.url) && <ExternalMark />}</a>{tagline.suffix && (
            <span data-tina-field={tinaField(tagline, 'suffix')}>{tagline.suffix}</span>
          )}
        </p>
      )}

      {colophon?.label && (
        <p class="colophon">
          {colophon.prefix && (
            <span data-tina-field={tinaField(colophon, 'prefix')}>{colophon.prefix}</span>
          )}<a
            href={colophon.url ?? '#'}
            target={ext(colophon.url) ? '_blank' : undefined}
            rel={ext(colophon.url) ? 'noopener noreferrer' : undefined}
            data-tina-field={tinaField(colophon, 'label')}
            class="link"
          >{colophon.label}{ext(colophon.url) && <ExternalMark />}</a>
        </p>
      )}
    </div>
  )}
</footer>

<style>
  /*
    The footer is the last thing on every page, so on a phone it ends where the
    home indicator begins and the bottom row sits under it. env() is 0 on every
    device without a notch, and max() means the existing pb-16 still wins there,
    so this only ever adds space where space is actually taken.
  */
  footer {
    padding-bottom: max(4rem, calc(1rem + env(safe-area-inset-bottom)));
  }

  .quiet {
    font-size: 14px;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .quiet:hover { color: var(--accent); }

  .tagline {
    font-size: 15px;
    color: var(--ink-3);
    margin: 0;
  }

  /* Sans and a step down: this is machine credit, not Hark's voice. */
  .colophon {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--ink-3);
    margin: 0;
  }
</style>
