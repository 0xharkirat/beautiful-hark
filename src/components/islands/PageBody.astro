---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { richTextComponents } from '../../lib/richtext';
import { tinaField } from '@tinacms/astro/tina-field';
import Blocks from '../blocks/Blocks.astro';
import type { CmsPage } from '../../lib/data';

interface Props {
	data?: CmsPage | null;
}

const { data } = Astro.props;

// A page is blocks, or prose, or both. Home and About are block pages and must
// keep rendering exactly as before, so the heading is drawn only for a prose
// page: a block page gets its title from inside a block, and adding an h1 here
// would give those two pages a second one.
const blocks = (data as any)?.blocks ?? null;
const hasBlocks = Array.isArray(blocks) && blocks.length > 0;
const body = (data as any)?.body ?? null;
---
{data && (
	<>
		{hasBlocks && <Blocks data={data} />}

		{body && (
			<article class="column">
				{!hasBlocks && data.title && (
					<h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
				)}
				<div data-tina-field={tinaField(data, 'body')} class="prose mt-6">
					<TinaMarkdown content={body} components={richTextComponents} />
				</div>
			</article>
		)}
	</>
)}

<!--
  No image styling here any more. It lived in this file as a `:global` selector
  reaching into the rich text, which worked but put image concerns in the page
  wrapper. MarkdownImage.astro renders images now and owns it.
-->
