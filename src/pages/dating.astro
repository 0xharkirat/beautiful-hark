---
/**
 * /dating — a standalone, unlisted profile page.
 *
 * Deliberately does NOT use Base.astro or global.css. It is its own document
 * with its own tokens so it reads as a separate thing from the rest of the
 * site. All content lives in the `dating` Tina collection; all UI lives in
 * src/components/dating/. Adding a photo or a prompt is a form edit.
 *
 * The editable half sits inside <TinaIsland>, so /admin gets side-by-side
 * visual editing the same way posts and pages do. The shell below (document,
 * tokens, behaviour script) stays outside, because the bridge replaces the
 * island's HTML on every keystroke.
 *
 * There is no like button and no message box. One reply route, at the bottom,
 * and it hands off to Instagram. Nothing here collects anything.
 *
 * Kept out of search by the noindex tag plus a sitemap filter in
 * astro.config.mjs. It is deliberately NOT listed in robots.txt, because
 * robots.txt is public and would advertise the path to anyone who looked.
 */
import '../styles/dating.css';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Analytics from '../components/Analytics.astro';
import DatingBody from '../components/islands/DatingBody.astro';
import { getDating } from '../lib/data';
import { islands } from '../lib/islands';

const result = await getDating();
const data = result.data?.dating;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
  <meta name="theme-color" content="#f6f3ee" />
  <title>{data?.name ?? 'Profile'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
  />
  {/* standalone: this page has no ClientRouter, so astro:page-load never fires
      and Umami has to do its own pageview. */}
  <Analytics standalone />
</head>
<body>

<TinaIsland name="dating" wrapper={islands.dating.wrapper} primary>
  <DatingBody data={data} />
</TinaIsland>

<div class="toast" data-toast role="status" aria-live="polite" hidden></div>

<style>
  .toast {
    position: fixed;
    z-index: 60;
    left: 50%;
    bottom: calc(24px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    padding: 12px 20px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    box-shadow: var(--shadow-float);
    animation: fade 180ms var(--ease-out);
  }

  @keyframes fade { from { opacity: 0; } }
</style>

<script>
  /*
   * Everything is delegated off `document` rather than bound per button. The
   * Tina bridge replaces the island's DOM on every edit, which would silently
   * kill per-node listeners halfway through an editing session.
   */
  const toastEl = document.querySelector<HTMLElement>('[data-toast]')!;
  let toastTimer: number | undefined;

  const closest = (t: EventTarget | null, sel: string) =>
    (t as HTMLElement | null)?.closest?.(sel) as HTMLElement | null;

  /** Duration scales with reading speed rather than a flat 2s. */
  function toast(text: string) {
    toastEl.textContent = text;
    toastEl.hidden = false;
    clearTimeout(toastTimer);
    const ms = Math.min(6000, Math.max(2200, (text.split(/\s+/).length / 220) * 60000 + 900));
    toastTimer = window.setTimeout(() => (toastEl.hidden = true), ms);
  }

  document.addEventListener('click', (e) => {
    /* ---------- tap anywhere on a photo to reveal its caption ---------- */
    const frame = closest(e.target, '[data-photo]');
    if (frame) {
      const open = frame.hasAttribute('data-open');
      frame.toggleAttribute('data-open', !open);
      frame.setAttribute('aria-expanded', String(!open));
      return;
    }

    /* ---------- tap anywhere on a clip to turn its sound on ---------- */
    const clip = closest(e.target, '[data-video]') as HTMLButtonElement | null;
    if (clip) {
      const v = clip.querySelector('video') as HTMLVideoElement | null;
      if (!v) return;
      muteAll(v);
      v.muted = !v.muted;
      clip.setAttribute('aria-pressed', String(!v.muted));
      clip.setAttribute(
        'aria-label',
        `${v.muted ? 'Turn the sound on' : 'Turn the sound off'} for this video`,
      );
      if (!v.muted) v.play().catch(() => {});
      return;
    }

    /* ---------- voice ---------- */
    const play = closest(e.target, '[data-audio]') as HTMLButtonElement | null;
    if (play) { togglePlay(play); return; }

    /* ---------- the one way out of this page ---------- */
    if (closest(e.target, '[data-cta]')) {
      // No preventDefault: the link opens in a new tab either way, and a
      // failed or blocked tracker must never cost someone the message.
      (window as any).umami?.track('dating-instagram');
      return;
    }

    /* ---------- share ---------- */
    if (closest(e.target, '[data-share]')) share();
  });

  /** Only one clip audible at a time. */
  function muteAll(except?: HTMLVideoElement) {
    document.querySelectorAll('video').forEach((v) => {
      if (v === except) return;
      v.muted = true;
      v.closest('[data-video]')?.setAttribute('aria-pressed', 'false');
    });
  }

  let audio: HTMLAudioElement | null = null;
  let playingBtn: HTMLButtonElement | null = null;

  function togglePlay(btn: HTMLButtonElement) {
    if (playingBtn === btn && audio && !audio.paused) {
      audio.pause();
      btn.removeAttribute('data-playing');
      return;
    }
    audio?.pause();
    playingBtn?.removeAttribute('data-playing');
    audio = new Audio(btn.dataset.audio!);
    playingBtn = btn;
    btn.setAttribute('data-playing', '');
    audio.addEventListener('ended', () => btn.removeAttribute('data-playing'));
    audio.play().catch(() => {
      btn.removeAttribute('data-playing');
      toast('That recording is not uploaded yet.');
    });
  }

  async function share() {
    const url = location.href;
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url }); } catch { /* cancelled */ }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      toast('Link copied.');
    } catch {
      toast(url);
    }
  }

  /* ---------- video plays only while it is on screen ---------- */

  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let io: IntersectionObserver | null = null;

  if (!still && 'IntersectionObserver' in window) {
    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.play().catch(() => {});
          } else {
            v.pause();
            // Leaving the screen also drops the sound, so scrolling away is
            // never followed by audio from a clip you can no longer see.
            if (!v.muted) {
              v.muted = true;
              v.closest('[data-video]')?.setAttribute('aria-pressed', 'false');
            }
          }
        }
      },
      { threshold: 0.6 },
    );
  }

  /** Re-run after the bridge swaps the island, so new videos still autoplay. */
  function watchVideos() {
    if (!io) return;
    document.querySelectorAll<HTMLVideoElement>('video').forEach((v) => io!.observe(v));
  }

  watchVideos();
  new MutationObserver(watchVideos).observe(document.body, { childList: true, subtree: true });
</script>

</body>
</html>
