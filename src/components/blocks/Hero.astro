---
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import type { HeroBlock } from '../../lib/data';

interface Props { data: HeroBlock }

const { data } = Astro.props;
const videoSrc = (data.image as any)?.videoSrc as string | undefined;
const videoUrl = (data.image as any)?.videoUrl as string | undefined;
const imgSrc = data.image?.src;
---

<section class="column">
  {data.headline && (
    <h1 data-tina-field={tinaField(data, 'headline')}>{data.headline}</h1>
  )}

  {data.tagline && (
    <p
      data-tina-field={tinaField(data, 'tagline')}
      class="tagline mt-3 whitespace-pre-line"
    >
      {data.tagline}
    </p>
  )}

  {videoSrc && (
    <figure class="hero-media" data-tina-field={tinaField(data, 'image')}>
      <video
        src={videoSrc}
        poster={videoSrc.replace(/\.webm$/, '-poster.jpg')}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={data.image?.alt ?? 'Hark, sitting still'}
      ></video>
      <!--
        The whole figure is the hit area, so this is one real <button> at
        inset:0 rather than a small control in the corner. That buys
        click-anywhere, keyboard access and a correct screen-reader
        announcement from a single element. The chip inside is decoration.
      -->
      <button
        type="button"
        class="sound-toggle"
        aria-pressed="false"
        aria-label="Turn sound on"
      >
        <span class="chip" aria-hidden="true">
          <span class="dot"></span>
          <span class="chip-label">click</span>
        </span>
      </button>
    </figure>
  )}

  {!videoSrc && videoUrl && (
    <figure class="hero-media" data-tina-field={tinaField(data, 'image')}>
      <iframe
        src={videoUrl}
        title={data.image?.alt ?? 'Video'}
        frameborder="0"
        allowfullscreen
      ></iframe>
    </figure>
  )}

  {!videoSrc && !videoUrl && imgSrc && (
    <figure class="hero-media" data-tina-field={tinaField(data, 'image')}>
      <Image
        src={imgSrc}
        alt={data.image?.alt ?? ''}
        width={1280}
        height={854}
        format="webp"
        quality={82}
      />
    </figure>
  )}
</section>

<style>
  .tagline {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* The video sits in the column like a figure, not a billboard.
     Spacing lives here rather than as a `mt-*` class: this rule has to
     zero the UA figure margin, and a scoped element rule outranks a
     Tailwind utility, so the utility would silently do nothing. */
  .hero-media {
    position: relative;
    margin: 40px 0 0;
    border-radius: 4px;
    overflow: hidden;
    background: color-mix(in oklab, var(--ink) 5%, transparent);
    line-height: 0;
  }
  .hero-media :is(video, iframe, img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* Sound is a click, not a hover: browsers refuse to play audio without a
     real user gesture, and mouseenter does not count as one. The button is
     the entire surface and carries no look of its own. */
  .sound-toggle {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  /* The global ring is 2px var(--accent) at +3px offset. --accent is
     near-black and an outward offset lands on the page rather than the
     media, so it would be low-contrast and in the wrong place. Inset it,
     and white clears 3:1 against every frame of this clip. Recheck if the
     hero is ever swapped for a lighter one. */
  .sound-toggle:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.9);
    outline-offset: -4px;
    border-radius: 4px;
  }

  /* The chip is an indicator, not the control, so it is free to be small:
     the 44px target is the figure itself. 4px radius and the sans stack
     match the rest of the site rather than inventing a pill. */
  .chip {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border-radius: 4px;
    /* Must stay legible over a photograph, so it cannot use --paper. */
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1;
    opacity: 0.6;
    transition: opacity 0.18s ease, transform 140ms var(--ease-out);
  }

  /* The chip moves; the video does not. It is already a moving, meditative
     thing, and scaling video tends to look cheap. */
  .sound-toggle:hover .chip,
  .sound-toggle:focus-visible .chip {
    opacity: 1;
    transform: translateY(-2px);
  }

  /* Press reads on the chip, not on .sound-toggle. The button is a transparent
     inset:0 layer, so scaling the button itself would animate nothing anyone
     can see. 0.96 because 0.95 and below reads as a bounce on something this
     small. Deliberately not behind (hover: hover): a press is the only
     feedback a touch reader ever gets, and it has to land after the :hover
     rule above, which is the same specificity. */
  .sound-toggle:active .chip {
    transform: scale(0.96);
  }

  /*
    The label morphs to fit its text instead of reserving room for the longest
    string.

    "click again" measures 65.34px against "click" at 28.30px in Inter at 13px,
    and the chip is anchored right, so an unmanaged swap drags its left edge
    across the frame.

    First attempt was min-width sized to "click again", which stopped the chip
    resizing but left "click" sitting in 38px of dead space. Reserving the worst
    case is the right instinct for content that arrives asynchronously and the
    wrong one here, where both strings are known and the change is a deliberate
    response to a click.

    So the width is set explicitly in JS from a measurement and transitioned.
    Animating width is a layout property, which is normally the thing to avoid,
    and it is safe in this one case: .chip is position:absolute, so its reflow is
    contained and cannot touch the page. There is no transform that changes a
    text box's width without stretching the glyphs, so this is the only way to
    morph rather than jump.
  */
  .chip-label {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    /* The UA centres text inside a <button>, and this inherits it. */
    text-align: left;
    transition:
      width 200ms var(--ease-out),
      filter 180ms ease,
      opacity 180ms ease;
  }


  @media (prefers-reduced-motion: reduce) {
    .chip-label { transition: filter 180ms ease, opacity 180ms ease; }
  }

  /* textContent lands in a single frame, so the swap needs something to cross.
     A soften rather than a move: nothing shifts, and the new word arrives out
     of the blur. 2px because blur() is genuinely expensive in Safari and
     anything larger only smears a 13px word into nothing. */
  .chip-label.swapping {
    filter: blur(2px);
    opacity: 0.7;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transition: background 0.18s ease, box-shadow 0.18s ease;
  }
  .sound-toggle[aria-pressed='true'] .dot {
    background: #8fe3b8;
    box-shadow: 0 0 0 3px rgba(143, 227, 184, 0.25);
  }

  /* Touch has no hover to reveal it, so show it at full strength. */
  @media (hover: none) {
    .chip { opacity: 1; }
  }

  /* Gentler, not off. The opacity cues survive - they are what tells the
     reader the chip is live and that the word changed. What goes is anything
     that reads as movement: the lift, the press, and the blur, which is the
     one people forget counts. The label still cross-fades. */
  @media (prefers-reduced-motion: reduce) {
    .sound-toggle:hover .chip,
    .sound-toggle:focus-visible .chip,
    .sound-toggle:active .chip {
      transform: none;
    }
    .chip-label.swapping {
      filter: none;
    }
  }
</style>

<script>
  function wireHero() {
    document.querySelectorAll<HTMLElement>('.hero-media').forEach((media) => {
      const video = media.querySelector('video');
      if (!video) return;

      /*
        Revive the video after a client-side navigation.

        Measured: first load gives paused:false, readyState:4. After
        navigating away and back it is paused:true, currentTime:0,
        readyState:0. readyState 0 is HAVE_NOTHING - the resource never
        began loading, because a <video> put into the DOM by a script does
        not reliably re-run the media load algorithm, so the autoplay
        attribute never fires. Kick it by hand.
      */
      if (video.autoplay && video.readyState === 0) {
        video.load();
        void video.play().catch(() => {});
      }

      if (media.dataset.soundBound) return;
      media.dataset.soundBound = '1';

      const button = media.querySelector<HTMLButtonElement>('.sound-toggle');
      const label = media.querySelector<HTMLElement>('.chip-label');
      if (!button) return;

      let raf = 0;
      const fadeTo = (target: number, done?: () => void) => {
        cancelAnimationFrame(raf);
        const step = () => {
          const delta = target - video.volume;
          if (Math.abs(delta) < 0.02) {
            video.volume = target;
            done?.();
            return;
          }
          video.volume = Math.min(1, Math.max(0, video.volume + delta * 0.15));
          raf = requestAnimationFrame(step);
        };
        step();
      };

      /*
        Blur the word, replace it halfway through, let it sharpen again. The
        class goes on, and 90ms later the text changes and the class comes off,
        so the swap happens inside the blur instead of in front of it. That
        90ms is also where the blur peaks, since it reverses there: the word
        never actually reaches the 2px the class asks for, and it should not -
        the point is to soften the cut, not to hide the chip.

        Rapid double-toggles queue two timers. They fire in order and both set
        an absolute string, so the final word is always right; only the middle
        blur gets clipped, which nobody can see at this speed.
      */
      /*
        Measured, not guessed. A hidden twin inherits the same font stack, size
        and letter-spacing as the label, so its box is the real rendered width of
        the string. Hardcoding a number here would drift the first time the font
        changes, and would be wrong on any platform that rasterises differently.
      */
      let measurer: HTMLElement | null = null;
      const widthOf = (text: string) => {
        if (!label) return 0;
        if (!measurer) {
          measurer = document.createElement('span');
          /*
            Positioned inline, not by class. Astro scopes component styles with a
            generated data attribute, and an element created here never carries
            it, so a `.chip-measure` rule in the <style> block below simply does
            not match. The first version relied on that rule and the twin stayed
            in normal flow inside the chip, widening it from 61px to 97px while
            the label itself measured correctly. Setting the properties that keep
            it out of flow directly is the only version that cannot silently fail.

            Still a child of .chip so it inherits the same font, size and
            letter-spacing. That inheritance is the entire point of measuring
            against a real element rather than computing from a font metric.
          */
          /*
            display:inline-block matters. The class on this element does nothing,
            per the note above, so without it the twin measures as an inline box
            while the real label is inline-block. The two round their widths
            differently, and .chip-label has overflow:hidden, so a shortfall of
            less than a pixel clipped the final letter: "click agai".
          */
          measurer.style.cssText =
            'position:absolute;visibility:hidden;pointer-events:none;' +
            'white-space:nowrap;left:-9999px;top:0;width:auto;' +
            'display:inline-block;';
          label.parentElement?.appendChild(measurer);
        }
        measurer.textContent = text;
        // Ceil, then 1px of slack. Sub-pixel text advance is not something a
        // layout width can hold exactly, and erring narrow costs a letter while
        // erring wide costs nothing anyone can see.
        return Math.ceil(measurer.getBoundingClientRect().width) + 1;
      };

      // Pin the starting width, or the first transition would run from `auto`
      // and the browser has nothing to interpolate from.
      if (label) label.style.width = `${widthOf(label.textContent ?? '')}px`;

      const swapLabel = (text: string) => {
        if (!label) return;
        // Width first and text second: the box starts travelling on this frame
        // while the old word is still legible, so the two changes overlap
        // instead of queueing. Swapping the text first would snap the width.
        label.style.width = `${widthOf(text)}px`;
        label.classList.add('swapping');
        setTimeout(() => {
          label.textContent = text;
          label.classList.remove('swapping');
        }, 90);
      };

      /*
        Every route into sound goes through here - click, keyboard, and the
        observer below - so the chip can never disagree with the video's
        real muted state. The chip is the only signal the reader has, and a
        chip reading "click again" over a silent video is worse than no chip.
      */
      const setSound = (on: boolean) => {
        button.setAttribute('aria-pressed', String(on));
        button.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
        // The chip invites rather than narrates - it never says "sound". State
        // still reads two ways without relying on colour: the words differ,
        // and the dot goes green. The aria-label above stays explicit, so
        // screen readers are told plainly what the control does.
        swapLabel(on ? 'click again' : 'click');

        if (on) {
          video.volume = 0;
          video.muted = false;
          // Unmuting can pause the element under autoplay policy; nudge it.
          void video.play().catch(() => {});
          fadeTo(1);
        } else {
          fadeTo(0, () => {
            video.muted = true;
          });
        }
      };

      // Enter and Space come free with a real <button>.
      button.addEventListener('click', () => setSound(video.muted));

      /*
        Audio trailing a reader down into a poem is the failure case being
        designed out, so leaving view mutes. Coming back does not unmute:
        turning sound on is always deliberate.
      */
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting && !video.muted) setSound(false);
          }
        },
        { threshold: 0.5 }
      ).observe(media);
    });
  }

  // Fires on the initial load and after every swap, so this is the only
  // registration needed - calling wireHero() directly as well would double
  // the readyState fix and restart the video.
  document.addEventListener('astro:page-load', wireHero);
</script>
