---
/**
 * Video embed for rich-text bodies.
 *
 * The Video template has been declared on the post body's rich text for a
 * while with nothing registered to render it, so `<Video>` in a post produced
 * no output at all - the schema advertised a feature that silently did nothing.
 *
 * Shares FigCaption with MarkdownImage, so a video caption behaves exactly like
 * an image caption: left aligned, and markdown so it can carry a link.
 */
import FigCaption from './FigCaption.astro';

interface Props {
  url?: string | null;
  poster?: string | null;
  autoPlay?: boolean | null;
  loop?: boolean | null;
  caption?: string | null;
}

const { url, poster, autoPlay, loop, caption } = Astro.props;

// Same guard as images: a URL comes from editable content and must never be
// allowed to become a javascript: or data: source.
const ok = (u?: string | null) =>
  u && /^(https?:\/\/|\/|\.\/|\.\.\/)/i.test(u) ? u : null;
const safe = ok(url);
const safePoster = ok(poster);

// Autoplay without muted is blocked by every browser, so asking for one implies
// the other. Requesting autoplay and silently getting a still frame is worse
// than muting something the reader did not choose to start.
const auto = !!autoPlay;

// A YouTube link in the same url field becomes an embed, so the schema and the
// lock file stay as they are and an editor pastes whatever link they have:
// watch?v=, youtu.be/, /embed/ or /shorts/. Only the 11 character id survives,
// and the player is built from it on youtube-nocookie, which sets no tracking
// cookies until the reader presses play.
const youtubeId = safe?.match(/^https?:\/\/(?:www\.|m\.)?(?:youtube(?:-nocookie)?\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})(?:[?&#/]|$)/i)?.[1] ?? null;

// An iframe needs a title for screen readers. The caption already names the
// video, so reuse it with markdown links reduced to their text and the SSW
// "Video:" prefix dropped.
const title =
  caption
    ?.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^Video:\s*/i, '')
    .trim() || 'YouTube video';
---

{youtubeId && (
  <figure class="fig">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title={title}
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
    {caption && <FigCaption caption={caption} />}
  </figure>
)}

{safe && !youtubeId && (
  <figure class="fig">
    {/*
      controls stays even on autoplay. An autoplaying loop longer than five
      seconds needs a way to stop it (WCAG 2.2.2), and this one runs 33s. That
      requirement is also the honest argument against shipping the same thing as
      a GIF: a GIF cannot be paused at all.

      preload is metadata, not auto, when there is no autoplay - no reason to
      pull a megabyte for a video nobody has asked to watch.
    */}
    {/*
      The poster is doing two jobs, and the second one is the reason it is not
      optional in practice.

      A <video> with no poster and no dimensions has nothing to compute
      `height: auto` from, so it lays out at the browser's default 150px and then
      snaps to its real height the moment metadata arrives. On this page that was
      a 252px shove of every paragraph below it, and until then the box was
      simply empty - which reads as "the video is broken" and is why refreshing
      appeared to fix it: the second load had the file cached, so metadata was
      instant. The browser takes the element's intrinsic size from the poster
      until the video's own metadata lands, so one attribute fixes the blank box
      and the reflow together.
    */}
    <video
      src={safe}
      poster={safePoster ?? undefined}
      autoplay={auto || undefined}
      muted={auto || undefined}
      loop={loop || undefined}
      playsinline
      controls
      preload={auto ? 'auto' : 'metadata'}
      data-autoplay={auto ? '' : undefined}
    ></video>
    {caption && <FigCaption caption={caption} />}
  </figure>
)}

{safe && !youtubeId && auto && (
  <script is:inline>
    /*
      Do not autoplay for a reader who asked for less motion. The site already
      takes this seriously enough to not load the phoenix at all under
      prefers-reduced-motion, so a 33s loop starting by itself would contradict
      that. The video stays, with its controls, and waits to be asked.

      Written as plain text, not {`...`}. is:inline passes a script body through
      verbatim, so a JSX expression is not evaluated - it reached the browser as
      a literal backtick-brace and threw a syntax error, which is a silent
      failure: the video kept autoplaying and nothing in the console said why.

      Runs immediately rather than on DOMContentLoaded, because autoplay starts
      as soon as the element is parsed and a listener would fire too late.
    */
    (() => {
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      for (const v of document.querySelectorAll('video[data-autoplay]')) {
        v.removeAttribute('autoplay');
        v.pause();
      }
    })();
  </script>
)}

<style>
  .fig {
    margin: 0;
  }
  .fig video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  /* An iframe has no intrinsic size, so the ratio reserves YouTube's 16:9 box
     before the player loads and nothing below it jumps. border: 0 replaces the
     deprecated frameborder attribute, as in Hero.astro. */
  .fig iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 4px;
  }
</style>
