---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Oneko from '../components/Oneko.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getGlobal } from '../lib/data';
import { islands } from '../lib/islands';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const config = (await getGlobal()).data?.global ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <TinaIsland name="global" wrapper={islands.global.wrapper}>
      <Header config={config} />
    </TinaIsland>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
      <Footer config={config} />
    </TinaIsland>

    <Oneko />
  </body>
</html>
