---
/**
 * oneko - the cat that follows the cursor.
 *
 * public/oneko.js is adryd325/oneko.js (MIT) vendored unmodified. It is
 * deliberately unmaintained upstream, so vendoring beats a dependency.
 *
 * Not the rozbrajaczpoziomow fork. Measured on a long post: its "scroll
 * handling" is `nekoPosY += event.deltaY / 10` on `wheel` only, so the cat
 * drifted 47.5px while the mouse sat still, then ran back. That breaks the
 * one property that makes a cat on every page safe - a parked mouse means a
 * sleeping cat. It also sets z-index to Number.MAX_VALUE, which is not an
 * integer, so the browser rejects it and the cat computes to z-index auto.
 * Upstream drifted 0.0px under the same test and keeps a valid z-index.
 */
---

<script is:inline>
  (() => {
    // No cursor to follow on touch, so it would just sit in a corner looking
    // broken. Skip the fetch entirely rather than hiding it with CSS.
    if (window.matchMedia('(hover: none)').matches) return;

    // oneko.js bails on reduced motion by itself, but checking here too means
    // we do not even request the script.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    if (window.__onekoLoaded) return;
    window.__onekoLoaded = true;

    /*
      Start the cat beside the wordmark instead of oneko's hardcoded 32,32.

      Done by seeding the localStorage entry the script already restores from
      on init, so oneko.js stays byte-identical to upstream. nekoPos is the
      cat's centre (it renders at nekoPos - 16), and setting mousePos to the
      same point means it arrives asleep rather than sprinting in from the
      corner.

      Only seeded when nothing is stored, so oneko's own persistence still
      wins on later visits and the cat resumes where the reader left it.
    */
    if (!localStorage.getItem('oneko')) {
      const brand = document.querySelector('header .wordmark');
      if (brand) {
        const r = brand.getBoundingClientRect();
        const x = r.right + 28;
        const y = r.top + r.height / 2;
        localStorage.setItem(
          'oneko',
          JSON.stringify({
            nekoPosX: x,
            nekoPosY: y,
            mousePosX: x,
            mousePosY: y,
            frameCount: 0,
            idleTime: 0,
            idleAnimation: null,
            idleAnimationFrame: 0,
            // spriteSets.idle is [[-3,-3]], and frames are 32px.
            bgPos: '-96px -96px',
          })
        );
      }
    }

    const script = document.createElement('script');
    script.src = '/oneko.js';
    // Required, not optional. The script defaults to "./oneko.gif", which is
    // relative - on /posts/some-slug/ that resolves to
    // /posts/some-slug/oneko.gif and 404s.
    script.dataset.cat = '/oneko.gif';
    script.onload = () => {
      document.getElementById('oneko')?.setAttribute('aria-hidden', 'true');
    };
    document.body.appendChild(script);

    /*
      Surviving navigation.

      oneko appends its element to document.body, which ClientRouter replaces
      on every swap, so the cat vanishes. Its listeners are on document and
      window, which persist, and its state lives in a closure - so carrying
      the same node across and re-appending it restores the cat exactly as it
      was. Re-running the script instead would add a second mousemove listener
      and a second cat.
    */
    let carried = null;
    document.addEventListener('astro:before-swap', () => {
      carried = document.getElementById('oneko');
    });
    document.addEventListener('astro:after-swap', () => {
      if (carried && !document.getElementById('oneko')) {
        document.body.appendChild(carried);
      }
    });
  })();
</script>

<style is:global>
  /*
    Behind the content: the cat slides under text and images and is fully
    visible in the wide margins either side of the 640px column, so it can
    never cover a word being read.

    -1 works here because body's background propagates to the canvas (html
    sets none), which paints before negative z-index. If a background is ever
    put on html, or an opaque one on a wrapper around the content, the cat
    disappears - check this rule first.

    oneko sets z-index inline, hence !important.
  */
  #oneko {
    z-index: -1 !important;
    pointer-events: none;
  }
</style>
