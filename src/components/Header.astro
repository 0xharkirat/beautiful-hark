---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsGlobal } from '../lib/data';
import ThemeToggle from './ThemeToggle.astro';
import HarkLogo from './HarkLogo.astro';
import ExternalMark from './richtext/ExternalMark.astro';
import { isExternal } from '../lib/links';

interface Props {
  config?: CmsGlobal | null;
}

const { config } = Astro.props;
const header = config?.header ?? null;
const nav = (header?.nav ?? []).filter((n) => n !== null);
const path = Astro.url.pathname;

/*
  A nav item may now point off-site, so each one is decided rather than assumed.

  An external link can never be the current page, so it gets neither is-active
  nor aria-current. Both would be a lie to a screen reader, which reads
  aria-current="page" as "you are here".

  Same isExternal the body text and the footer use. Deciding it a fourth time in
  a fourth file is how the footer and the rich-text renderer ended up disagreeing
  about target="_blank" in the first place.
*/
const external = (href: string | null | undefined) => isExternal(href, Astro.site);

/*
  Resolved through URL, not string-compared, so this agrees with the sync script
  at the bottom of this file.

  Those two had drifted: the script was taught to resolve absolute hrefs and this
  was not, so a same-origin absolute URL got no aria-current from the server and
  then got one from the script on the next navigation. Nothing in the nav is
  written that way today, which is exactly why it would have sat here unnoticed.

  Trailing slashes vary by host and by dev vs build, so '/about/' has to count as
  '/about'. Home is compared exactly, or it would match every path.
*/
const isActive = (href: string) => {
  if (!href || external(href)) return false;
  let h: string;
  try {
    // A base is required for relative hrefs; the origin is discarded either way
    // because external ones already returned above.
    h = new URL(href, 'http://h').pathname.replace(/\/+$/, '') || '/';
  } catch {
    return false;
  }
  const p = path.replace(/\/+$/, '') || '/';
  return h === '/' ? p === '/' : p === h || p.startsWith(h + '/');
};
---

<!-- Persist across swaps so the nav does not flash on every navigation. The
     directive has to sit on the element: putting it on <Header> in Base.astro
     emitted no marker at all. -->
<header class="column pt-10 pb-8" transition:persist>
  <a href="/" class="wordmark" aria-label="Home">
    <HarkLogo trackEyes={true} className="size-8" />
    <span class="serif">{header?.name ?? 'Tales of Hark'}</span>
  </a>

  <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <nav aria-label="Primary" class="contents">
      {nav.map((item) => {
        const href = item.href ?? '#';
        const off = external(href);
        return (
          <a
            href={href}
            data-tina-field={tinaField(item, 'label')}
            class:list={['nav', 'tap', { 'is-active': !off && isActive(href) }]}
            aria-current={!off && isActive(href) ? 'page' : undefined}
            target={off ? '_blank' : undefined}
            rel={off ? 'noopener noreferrer' : undefined}
          >
            {item.label}{off && <ExternalMark />}
          </a>
        );
      })}
    </nav>
    <ThemeToggle />
  </div>
</header>

<script is:inline>
  /*
    Recompute which tab is current after every client-side navigation.

    transition:persist above carries this header across swaps as the same DOM
    node, which is what stops it flashing - but it also means the is-active
    class baked in at build time is the one for whatever page the reader first
    landed on, and it never changes again. Going Home -> /hawky left Home lit;
    going About -> /hawky left About lit. A fresh load of /hawky was always
    correct, which is why this hid: it only shows up when you click.

    Reads each link's own href and applies the same rule as the server, so the
    two cannot drift apart into different answers.
  */
  (() => {
    const sync = () => {
      const p = location.pathname.replace(/\/+$/, '') || '/';
      for (const a of document.querySelectorAll('header a.nav')) {
        /*
          Resolve through URL rather than string-matching the raw href.

          A nav item can now be an absolute URL. An off-site one must never light
          up, and a same-origin absolute URL must still light up on its own page.
          Comparing the raw attribute got the second case wrong: the server
          marked it current and this loop unmarked it on the next navigation,
          because "https://harksingh.com/about" never startsWith "/about".
        */
        const raw = a.getAttribute('href') || '';
        let u;
        try { u = new URL(raw, location.origin); } catch { continue; }
        if (u.origin !== location.origin) {
          a.classList.remove('is-active');
          a.removeAttribute('aria-current');
          continue;
        }
        const h = u.pathname.replace(/\/+$/, '') || '/';
        const on = h === '/' ? p === '/' : p === h || p.startsWith(h + '/');
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
    };
    // page-load fires on first load and after every view transition.
    document.addEventListener('astro:page-load', sync);
    sync();
  })();
</script>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .wordmark span {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .nav {
    font-size: 15px;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav:hover { color: var(--accent); }
  .nav.is-active {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* The toggle is furniture, so it keeps a nav link's weight and baseline. */
  header :global(button) {
    color: var(--ink-3);
    transition: color 0.15s ease;
  }
  header :global(button:hover) { color: var(--accent); }

  /*
    The toggle flows with the links instead of being positioned against them.

    It has now been wrong in both directions. A fixed 24px margin pushed it off
    the right of a phone screen entirely, 115px past the viewport, and with
    overflow-x: clip on html that was unreachable rather than merely ugly. An
    auto margin fixed the reachability and stranded it instead: the nav wrapped
    to two lines, the toggle landed alone on a third, and the auto margin threw
    it to the far right of that line.

    Both failures come from the same cause. The toggle was a sibling of the
    whole nav block, so it could only ever be positioned relative to all of the
    links at once, never placed among them.

    `display: contents` on the nav dissolves that box, so the links become items
    of the same row the toggle is in and it simply wraps as the seventh thing in
    the line. No margin needed, and nothing to re-guess when a link is added.
    The nav element stays for the landmark; only its box is gone.
  */
  header nav.contents {
    display: contents;
  }
</style>
