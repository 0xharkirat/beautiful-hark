---
/**
 * Umami, replacing Google Analytics.
 *
 * GA was wired here and dormant: 49 lines behind PUBLIC_GA_ID that were never
 * switched on. Leaving it was the risk rather than running it. Setting that one
 * variable would have shipped roughly 50KB of gtag plus cookies that legally
 * need a consent banner, onto a site whose whole browser payload is one 16KB
 * bundle. Umami is about 2KB, sets no cookies and needs no banner.
 */

/*
  The website id sits in the source because it is not a secret and cannot be.
  Umami reads it from a script tag in the page, so it reaches every visitor's
  browser by definition; hiding it in an env var would protect nothing and only
  make a local build behave differently from a deployed one.
 */
const UMAMI_ID = 'd9ea7c53-94ff-4e81-871a-7a582241c020';

/*
  Production deploys only, decided at build time rather than by remembering a
  setting.

  Gating on an env var meant setting it in Vercel and scoping it correctly, and
  the failure mode of getting that wrong is silent: set it for Preview too and
  every deploy preview counts itself as a visitor, quietly inflating the numbers
  with your own traffic. VERCEL_ENV is set by Vercel and is 'production' only on
  a production deploy, so previews and local dev are excluded by construction
  instead of by discipline.

  To check it locally: VERCEL_ENV=production pnpm build.
*/
const enabled = process.env.VERCEL_ENV === 'production';

/*
  standalone: for a page that does not use Base.astro, and therefore has no
  ClientRouter.

  The manual-tracking dance below exists purely because ClientRouter navigates
  with pushState. A page without it never fires astro:page-load, so the listener
  would never run and the pageview would never send: the script would load and
  report nothing, which is worse than no script because it looks like it works.

  With no pushState in play, Umami's own auto-tracking is simply correct, so
  standalone drops the data-auto-track override and the listener entirely.
*/
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
---

{
  enabled && (
    <>
      {/*
        data-auto-track="false", then one manual track per astro:page-load.

        Umami's auto-tracking hooks pushState, and ClientRouter uses pushState,
        so leaving it on would half-work by accident while counting a navigation
        Astro has not finished swapping, leaving the URL and the title
        disagreeing about which page was viewed.

        Verified against the tracker source that this is safe: auto-track off
        skips the automatic pageview and the history hooks, and still exposes
        window.umami.track for the listener below to call.
      */}
      {/* In standalone mode the attribute is omitted rather than set to
          "true": absent is Umami's own default and the documented way to leave
          auto-tracking on. */}
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={UMAMI_ID}
        data-auto-track={standalone ? undefined : 'false'}
      />
      {!standalone && (
      <script is:inline>
        {/*
          The head persists across swaps, so this should register once. Guard
          anyway: a second listener doubles every page view, and quietly
          inflated numbers are worse than no numbers.
        */}
        if (!window.__umamiBound) {
          window.__umamiBound = true;
          document.addEventListener('astro:page-load', () => {
            /*
              The url has to be passed explicitly. A bare track() reports the
              url captured when the script first ran, every single time.

              Umami keeps the current url in a variable that its history hook
              updates, and that hook is only installed inside the auto-track
              branch, which is off here. So the title updates, being read live,
              and the url does not. Measured: after a pushState to
              /second-page, a bare track() still sent /start.

              Every client-side navigation on this site would have been recorded
              as whatever page the reader first landed on, which is worse than
              no analytics, because the numbers look plausible.

              The function form is used rather than a plain object so referrer,
              screen size and the rest survive instead of being replaced.

              Optional chaining because the script is deferred: the first
              page-load can beat it, and a missing umami must not throw.
            */
            window.umami?.track((props) => ({
              ...props,
              url: location.pathname + location.search,
              title: document.title,
            }));
          });
        }
      </script>
      )}
    </>
  )
}
