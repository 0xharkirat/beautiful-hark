---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsPost } from '../../lib/data';

interface Props {
  data?: CmsPost | null;
}

const { data } = Astro.props;
const date = data?.date
  ? new Date(data.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

{data && (
  <div class="column">
    <header class="mb-8">
      {data.title && (
        <h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
      )}
      {date && (
        <p data-tina-field={tinaField(data, 'date')} class="meta mt-2">{date}</p>
      )}
    </header>

    {data._body && (
      <div data-tina-field={tinaField(data, '_body')} class="prose">
        <TinaMarkdown content={data._body} />
      </div>
    )}
  </div>
)}
