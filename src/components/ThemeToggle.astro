---
// Sits on the nav baseline as a word, not a floating icon button.
---
<button data-theme-toggle class="tap" type="button" aria-label="Toggle color theme">
  <span class="light-only">dark</span>
  <span class="dark-only">light</span>
</button>

<style>
  button {
    /* No padding reset here — it would beat .tap's hit-area padding,
       since a scoped element selector outranks a global class. */
    padding-inline: 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink-3);
    cursor: pointer;
  }
  button:hover { color: var(--ink); }

  /* The attribute is in this selector to win a specificity fight, not for
     precision: Header.astro reaches in with `header :global(button)`, which
     outranks a bare scoped `button` and would replace this whole shorthand
     with its own colour-only transition. Losing it leaves the press snapping
     back with no ease on release, which is the half of a press people
     actually notice. */
  button[data-theme-toggle] {
    transition: color 0.15s ease, transform 140ms var(--ease-out);
  }

  /* Same 0.96 as the hero chip so presses read as one system, and not gated
     behind (hover: hover) because touch has nothing else. Colour moves with
     the scale, so the reduced-motion rule below can drop the transform and
     still leave the tap answered. */
  button:active {
    color: var(--ink);
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    button:active { transform: none; }
  }

  .dark-only { display: none; }
  :global(.dark) .light-only { display: none; }
  :global(.dark) .dark-only { display: inline; }
</style>

<script is:inline>
  // Delegate from document so the handler survives DOM swaps from Astro's
  // ClientRouter and Tina's visual-editor re-renders.
  if (!window.__themeToggleBound) {
    window.__themeToggleBound = true;
    document.addEventListener('click', (e) => {
      if (!e.target.closest('[data-theme-toggle]')) return;
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>
