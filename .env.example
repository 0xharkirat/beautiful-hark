SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io
# Umami website ID, from the site's settings in Umami Cloud.
# Optional: analytics renders nothing when unset, so local dev and preview
# builds stay clean. Set it for Production only in Vercel, or your own preview
# deploys will be counted as traffic.
PUBLIC_UMAMI_WEBSITE_ID=
